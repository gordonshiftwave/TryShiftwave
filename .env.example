# Asset public path (Vite `base`). Must end with / unless you use relative `./`.
# Leave unset for local `npm run dev` (`/`) and for GitHub Pages builds (`/TryShiftwave/`).
# Production on shiftwave.co:
#   VITE_BASE=/
#   VITE_BASE=/pages/find-shiftwave/
# Relative URLs when dropping dist/ into another host:
#   VITE_BASE=./
# VITE_BASE=/

# Bake embed/full-bleed layout (no standalone "live partner list" banner).
# Also enabled at runtime with ?embed=1, /embed.html, or an iframe.
# VITE_EMBED=true

# Locations feed (JSON or CSV). Prefers this URL; falls back to public/locations.json.
# Point at a CORS-enabled JSON export that matches INTEGRATION.md. Raw Google
# /export?format=csv URLs usually fail CORS in the browser.
#
# Root-absolute paths are resolved under Vite `base`.
# VITE_LOCATIONS_URL=/locations.json
# VITE_LOCATIONS_URL=/locations.csv
# VITE_LOCATIONS_URL=https://cdn.shiftwave.co/find/locations.json
# VITE_LOCATIONS_URL=https://opensheet.elk.sh/SPREADSHEET_ID/Locations

# Standing intake is Shopify tag → staging → human qualify → this feed. See OPS.md.
# API staging (preferred when set): Dev Dashboard client credentials, not a shpat_ token.
# Do not paste these values into chat. Never commit .env or live ops/staging.json.
# SHOPIFY_SHOP=your-store-subdomain
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-07

